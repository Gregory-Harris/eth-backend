# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=ethcare
DATABASE_PASSWORD=your_secure_password
DATABASE_NAME=ethcare_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Blockchain
ETHEREUM_NETWORK=sepolia
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
ETHEREUM_PRIVATE_KEY=0x_your_private_key_for_backend_operations
CONTRACT_ADDRESS=0x_your_deployed_contract_address

# IPFS
IPFS_HOST=localhost
IPFS_PORT=5001
IPFS_PROTOCOL=http
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=your_super_secret_refresh_key
JWT_REFRESH_EXPIRATION=7d

# Encryption
ENCRYPTION_KEY=32_byte_encryption_key_change_this
ENCRYPTION_ALGORITHM=aes-256-gcm

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=http://localhost:3001,http://localhost:4200

# File Upload
MAX_FILE_SIZE=10485760

# Emergency Access
EMERGENCY_ACCESS_DURATION_HOURS=72
EMERGENCY_COOLDOWN_HOURS=24
